# Copie para .env (local) ou cadastre em Azure > App Service > Configuração > Variáveis de ambiente.
NODE_ENV=production
# Endereço público da plataforma, usado nos links dos e-mails
URL_BASE=https://negociacao.yukaer.com.br
# Pasta dos dados (banco e documentos). No Azure o padrão já é /home/data
# PASTA_DADOS=/home/data
# E-mails que recebem aviso de boleta nova (separe por vírgula). Vazio = todos os usuários da mesa
EMAILS_MESA=mesa@yukaer.com.br
# Envio de e-mail pelo Microsoft 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=plataforma@yukaer.com.br
SMTP_PASS=
SMTP_FROM=plataforma@yukaer.com.br
